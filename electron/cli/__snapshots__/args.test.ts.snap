                        "minimum": 0,
                        "type": "number",
                      },
                    },
                    "required": [
                      "seconds",
                      "base",
                    ],
                    "type": "object",
                  },
                ],
              },
              {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "base": {
                        "enum": [
                          "edited",
