    "batch": {
      "description": "batch --input steps.json [--stop-on error|warning] [--verbosity summary|full]: run a JSON array of agent commands in order against the live editor. Every step is validated before any write runs; steps without --request_id join one undo group (undo --to <batch_id>). One summary envelope reports per-step status, exit codes, introduced findings, before/after hashes, rendered frames, and the first failure. Nested batch steps are rejected.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "input": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string",
          },
          "stop_on": {
            "default": "error",
            "enum": [
              "error",
              "warning",
            ],
            "type": "string",
          },
          "verbosity": {
            "default": "summary",
            "enum": [
              "summary",
              "full",
            ],
            "type": "string",
          },
        },
        "required": [
          "input",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "commit_document",
        ],
        "requires": [
          "editor",
        ],
        "verification": [
          "changed_span",
          "boundaries",
          "live_seek",
          "live_playback",
          "span_export",
          "isolated_audio",
          "listening",
        ],
      },
    },
    "broll": {
      "description": "broll add/swap. broll swap --overlay ID --file /absolute/video.mp4. Swap keeps placement, clip, motion and opacity. --fit auto (default) covers within 8% aspect difference, otherwise contains; cover/contain force it. --offset seconds defaults to 0; --time trim (default) shortens to available media, hold keeps the last frame. At most 0.5s available fails MEDIA_TOO_SHORT. Use remove + add to create a different slot.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "add",
                "type": "string",
              },
              "anchor": {
                "default": "center",
                "enum": [
                  "top-left",
                  "top",
                  "top-right",
                  "left",
                  "center",
                  "right",
                  "bottom-left",
                  "bottom",
                  "bottom-right",
                ],
                "type": "string",
              },
              "at": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "base": {
                        "enum": [
                          "edited",
                          "raw",
                          "source",
                          "output",
                        ],
                        "type": "string",
                      },
                      "seconds": {
                        "minimum": 0,
                        "type": "number",
                      },
                    },
                    "required": [
                      "seconds",
                      "base",
                    ],
                    "type": "object",
                  },
                ],
              },
              "file": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string",
              },
              "fit": {
                "default": "cover",
                "enum": [
                  "cover",
                  "contain",
                ],
                "type": "string",
              },
              "force": {
                "default": false,
                "type": "boolean",
