                "minimum": 0,
                "type": "number",
              },
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "base": {
                    "enum": [
                      "edited",
                      "raw",
                      "source",
                      "output",
                    ],
                    "type": "string",
                  },
