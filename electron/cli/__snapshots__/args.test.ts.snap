    "transcript": {
      "description": "Read saved source-time words: --clip ID for one clip or --all for every clip and derived sentences. Use --project PATH or --project_id ID. --all pages stay below 48 KiB; follow next_page with --page and reuse --snapshot.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "all": {
            "default": false,
            "type": "boolean",
          },
          "clip": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "limit": {
            "default": 200,
            "maximum": 500,
            "minimum": 1,
            "type": "integer",
          },
          "min_gap": {
            "default": 0.5,
            "maximum": 60,
            "minimum": 0.05,
            "type": "number",
          },
          "offset": {
            "default": 0,
            "maximum": 1000000,
