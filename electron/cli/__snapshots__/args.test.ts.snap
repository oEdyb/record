    "state": {
      "description": "Read scene state at edited --at seconds or m:ss.s; r/s suffixes name raw/source. Optional --range from to. The reply carries all three bases.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "at": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number",
              },
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "base": {
                    "enum": [
                      "edited",
                      "raw",
                      "source",
                      "output",
                    ],
                    "type": "string",
                  },
                  "seconds": {
                    "minimum": 0,
                    "type": "number",
                  },
                },
                "required": [
                  "seconds",
                  "base",
                ],
                "type": "object",
              },
            ],
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "range": {
            "prefixItems": [
              {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "base": {
                        "enum": [
                          "edited",
                          "raw",
                          "source",
                          "output",
                        ],
                        "type": "string",
                      },
                      "seconds": {
                        "minimum": 0,
                        "type": "number",
                      },
                    },
                    "required": [
                      "seconds",
                      "base",
                    ],
                    "type": "object",
                  },
                ],
              },
              {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
