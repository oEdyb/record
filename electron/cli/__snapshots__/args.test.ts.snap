// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`additive-only api_version 1.x contract > pins every command's description and input schema surface 1`] = `
{
  "commands": {
    "accept": {
      "description": "Accept proposed cuts. One undo step; optional --ids a,b; otherwise accepts selected and clears the lane.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "ids": {
            "minLength": 1,
            "type": "string",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "project_id",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "commit_document",
        ],
        "requires": [
          "editor",
        ],
        "verification": [
          "changed_span",
          "boundaries",
          "live_seek",
          "live_playback",
          "span_export",
          "isolated_audio",
          "listening",
        ],
      },
    },
    "apply": {
      "description": "Apply a prepared plan once. Requires the running opt-in editor; preserve request_id for recovery. --deep adds a decoded content pass over the touched span to the verify block.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "deep": {
            "type": "boolean",
          },
