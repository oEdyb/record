    "preview": {
      "description": "Render one composed PNG at export/output time from a hash-bound saved project. --time is speed-adjusted output seconds when bare; e/r/s suffixes convert through the timeline. Experimental: seeks one native still frame; at most 128 clips, 128 assets, and 1280 pixels per side. Requires a current native build.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
