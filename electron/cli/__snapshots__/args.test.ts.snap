                  "base": {
                    "enum": [
                      "edited",
                      "raw",
                      "source",
                      "output",
                    ],
                    "type": "string",
                  },
                  "seconds": {
                    "minimum": 0,
                    "type": "number",
                  },
                },
                "required": [
                  "seconds",
                  "base",
                ],
                "type": "object",
              },
            ],
          },
          "live": {
            "default": false,
            "type": "boolean",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "words": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "project_id",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "write_artifacts",
          "seek_when_live",
        ],
        "requires": [
          "editor",
        ],
        "verification": [],
      },
