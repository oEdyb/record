    "pauses": {
      "description": "Ask the open editor to find shortenable pauses with the editor's own detector (preset natural|balanced|tight, optional overrides) and return paged suggestions plus ready addTrim operations. Repeat until status is ready. A ready page stages its operations into the proposal lane by default — nothing is written; review with staged, then accept or reject. --accept "<reason>" applies the page directly.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "accept": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "clips": {
            "minLength": 1,
            "type": "string",
          },
          "ignore_non_speech": {
            "enum": [
              "true",
              "false",
            ],
            "type": "string",
          },
          "keep_after": {
            "maximum": 60,
            "minimum": 0,
            "type": "number",
          },
          "keep_before": {
            "maximum": 60,
            "minimum": 0,
            "type": "number",
          },
          "limit": {
            "default": 200,
            "maximum": 500,
            "minimum": 1,
            "type": "integer",
          },
          "min_pause": {
            "maximum": 60,
            "minimum": 0,
            "type": "number",
          },
          "mode": {
            "enum": [
              "speech",
              "audio-level",
            ],
            "type": "string",
          },
          "offset": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer",
          },
          "preset": {
            "default": "balanced",
            "enum": [
              "natural",
              "balanced",
              "tight",
            ],
            "type": "string",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "protect_screen_activity": {
            "enum": [
              "true",
              "false",
            ],
            "type": "string",
          },
          "protect_system_audio": {
            "enum": [
              "true",
              "false",
            ],
            "type": "string",
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
          "shortened": {
            "maximum": 60,
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "project_id",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "stage_proposals",
          "commit_when_accepted",
        ],
        "requires": [
          "editor",
        ],
        "verification": [
          "changed_span",
          "boundaries",
          "live_seek",
          "live_playback",
          "span_export",
          "isolated_audio",
          "listening",
        ],
      },
    },
