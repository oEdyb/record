            "default": 1,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "pad_after": {
            "default": 0.15,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "pad_before": {
            "default": 0.1,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "remove": {
            "default": "false",
            "enum": [
              "true",
              "false",
            ],
            "type": "string",
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "project_id",
        ],
        "type": "object",
      },
