    "timeline": {
      "description": "Read clips plus separately paged effect/audio lanes from a saved snapshot. Use each lane next_offset as --offset; IDs are edit targets, offsets are read positions.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
