      "description": "Restore before-documents via guarded apply; --steps N or --to APPLY_ID. --force bypasses intervening edit refusal.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
