    "cutpoint": {
      "description": "Where a sentence really ends or starts near --time in --clip: bare numbers stay source seconds (compatibility); 103e/1:43 (edited) and 125.3r (raw) convert, and the reply carries all three bases. The transcript picks the nearest sentence boundary, the microphone level finds the last sound of it (--edge out) or the first sound of the next one (--edge in), and cut_sec adds --pad_after / --pad_before. A chosen cut stages the footage it removes into the proposal lane by default — nothing is written; review with staged, then accept or reject. --accept "<reason>" applies directly. Repeat until status is ready.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "accept": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "clip": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "edge": {
            "enum": [
              "out",
              "in",
            ],
            "type": "string",
          },
          "pad_after": {
            "default": 0.15,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "pad_before": {
            "default": 0.1,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
          "sentence_gap": {
            "default": 0.8,
            "maximum": 10,
            "minimum": 0,
            "type": "number",
          },
          "time": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number",
              },
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "base": {
                    "enum": [
                      "edited",
                      "raw",
                      "source",
                      "output",
                    ],
                    "type": "string",
                  },
                  "seconds": {
                    "minimum": 0,
                    "type": "number",
                  },
                },
                "required": [
                  "seconds",
                  "base",
                ],
                "type": "object",
              },
            ],
          },
        },
        "required": [
          "project_id",
          "clip",
          "time",
          "edge",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "stage_proposals",
          "commit_when_accepted",
        ],
        "requires": [
          "editor",
        ],
        "verification": [
          "changed_span",
          "boundaries",
          "live_seek",
          "live_playback",
          "span_export",
          "isolated_audio",
          "listening",
        ],
      },
    },
