    "layout": {
      "description": "layout set --scope project|clip:ID: guarded plan/apply, then state at the clip's first kept second. Keep --request_id for recovery.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "set",
            "type": "string",
          },
          "camera_anchor": {
            "anyOf": [
              {
                "enum": [
                  "top-left",
                  "top",
                  "top-right",
                  "left",
                  "center",
                  "right",
                  "bottom-left",
                  "bottom",
                  "bottom-right",
                ],
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "cx": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                  "cy": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                },
                "required": [
                  "cx",
                  "cy",
                ],
                "type": "object",
              },
            ],
            "description": "--camera-anchor: named anchor or JSON {cx,cy} normalized coordinates.",
          },
          "camera_shape": {
            "enum": [
              "rectangle",
              "circle",
              "square",
              "rounded",
              "squircle",
            ],
            "type": "string",
          },
          "camera_size": {
            "anyOf": [
              {
                "enum": [
                  "XS",
                  "S",
                  "M",
                  "L",
                  "XL",
                ],
                "type": "string",
              },
              {
                "maximum": 80,
                "minimum": 10,
                "type": "number",
              },
            ],
            "description": "--camera-size: XS/S/M/L/XL or percent 10..80.",
          },
          "captions": {
            "enum": [
              "on",
              "off",
            ],
            "type": "string",
          },
          "force": {
            "type": "boolean",
          },
          "project_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string",
          },
          "scope": {
            "maxLength": 261,
            "pattern": "^(?:project|clip:.+)$",
            "type": "string",
          },
        },
        "required": [
          "action",
          "project_id",
          "scope",
        ],
        "type": "object",
      },
      "policy": {
        "effects": [
          "commit_document",
        ],
        "requires": [
          "editor",
        ],
        "verification": [
          "changed_span",
          "boundaries",
          "live_seek",
          "live_playback",
          "span_export",
        ],
      },
    },
