<?xml version="1.0" encoding="UTF-8"?>
<!--
  Upstream AppStream metadata for software centres. Nothing packages this file yet; CI only
  validates it. The component ID matches the Electron appId and desktop file. Changing it does not
  touch user data, which lives in a folder chosen by electron/userDataLocation.ts.
-->
<component type="desktop-application">
  <id>co.dyberg.klippt</id>

  <name>Klippt</name>
  <summary>Record your screen in clips</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <developer id="co.dyberg">
    <name>Olle Dyberg</name>
  </developer>

  <description>
    <p>
      Klippt is a free, open-source screen recorder that records in clips, with local speech
      cleanup and no account.
    </p>
    <ul>
      <li>Pause and continue, and drop a bad clip while you record</li>
      <li>Review the take, then save the untouched source files or one finished video</li>
      <li>Clean cut removes speech mistakes with a speech model that runs on your machine</li>
      <li>Export to MP4 or GIF</li>
    </ul>
    <p>
      Klippt is built on OpenScreen. Screen capture goes through the desktop portal and PipeWire.
    </p>
  </description>

  <launchable type="desktop-id">co.dyberg.klippt.desktop</launchable>

  <url type="homepage">https://github.com/oEdyb/record</url>
  <url type="bugtracker">https://github.com/oEdyb/record/issues</url>
  <url type="vcs-browser">https://github.com/oEdyb/record</url>
  <url type="contribute">https://github.com/oEdyb/record/blob/main/CONTRIBUTING.md</url>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/oEdyb/record/main/artifacts/linux-port-2026-10-26/cursor-preview/review.png</image>
      <caption>Reviewing a recording on Linux</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Recorder</category>
  </categories>

  <keywords>
    <keyword>screen recorder</keyword>
    <keyword>screencast</keyword>
    <keyword>screen capture</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.9.5" date="2026-11-03" />
  </releases>
</component>
