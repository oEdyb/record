{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://klippt.app/schemas/creator-corpus/result-v1.json",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"runId",
		"createdAt",
		"corpus",
		"fixture",
		"provenance",
		"environment",
		"status",
		"invariants",
		"measurement"
	],
	"properties": {
		"schemaVersion": { "const": 1 },
		"runId": { "$ref": "#/$defs/id" },
		"createdAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
		},
		"corpus": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "version", "manifestSha256", "splitLockSha256"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"version": { "$ref": "#/$defs/semver" },
				"manifestSha256": { "$ref": "#/$defs/sha256" },
				"splitLockSha256": { "$ref": "#/$defs/sha256" }
			}
		},
		"fixture": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "revision", "split"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"revision": { "type": "integer", "minimum": 1 },
				"split": { "enum": ["development", "tuning", "holdout"] }
			}
		},
		"provenance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sourceSha256", "toolSha256", "modelSha256", "policySha256"],
			"properties": {
				"sourceSha256": { "$ref": "#/$defs/hashListOne" },
				"toolSha256": { "$ref": "#/$defs/hashListOne" },
				"modelSha256": { "$ref": "#/$defs/hashList" },
				"policySha256": { "$ref": "#/$defs/hashListOne" }
			}
		},
		"environment": {
			"type": "object",
			"additionalProperties": false,
			"required": ["platform", "arch"],
			"properties": {
				"platform": { "enum": ["darwin", "win32", "linux"] },
				"arch": { "enum": ["arm64", "x64"] },
				"osVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
				"hardwareClass": { "type": "string", "minLength": 1, "maxLength": 80 },
				"lowPowerMode": { "type": "boolean" },
				"thermalState": { "enum": ["nominal", "fair", "serious", "critical", "unknown"] }
			}
		},
		"status": { "enum": ["passed", "failed", "error"] },
		"failureCodes": {
			"type": "array",
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/id" }
		},
		"invariants": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "passed", "observed"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"passed": { "type": "boolean" },
					"observed": {
						"oneOf": [
							{ "type": "number" },
							{
								"type": "string",
								"maxLength": 80,
								"pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
							},
							{ "type": "boolean" }
						]
					}
				}
			}
		},
		"measurement": {
			"oneOf": [
				{ "$ref": "#/$defs/capture" },
				{ "$ref": "#/$defs/export" },
				{ "$ref": "#/$defs/audio" },
				{ "$ref": "#/$defs/asr" },
				{ "$ref": "#/$defs/automaticDirection" },
				{ "$ref": "#/$defs/uiPerformance" }
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
			"maxLength": 100
		},
		"semver": {
			"type": "string",
			"pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
		},
		"sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"hashList": {
			"type": "array",
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/sha256" }
		},
		"hashListOne": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/sha256" }
		},
		"capture": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"durationMs",
				"requestedFps",
				"deliveredFps",
				"droppedFrames",
				"avDriftMs",
				"fatalWriterErrors",
				"mediaDiscontinuities"
			],
			"properties": {
				"kind": { "const": "capture" },
				"durationMs": { "$ref": "#/$defs/nonNegative" },
				"requestedFps": { "$ref": "#/$defs/nonNegative" },
				"deliveredFps": { "$ref": "#/$defs/nonNegative" },
				"droppedFrames": { "$ref": "#/$defs/nonNegativeInteger" },
				"avDriftMs": { "type": "number" },
				"fatalWriterErrors": { "$ref": "#/$defs/nonNegativeInteger" },
				"mediaDiscontinuities": { "$ref": "#/$defs/nonNegativeInteger" }
			}
		},
		"export": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"durationMs",
				"wallTimeMs",
				"throughputFps",
				"outputBytes",
				"outputSha256",
				"hardwareEncoder",
				"avDriftMs",
				"durationErrorMs",
				"peakRssBytes"
			],
			"properties": {
				"kind": { "const": "export" },
				"durationMs": { "$ref": "#/$defs/nonNegative" },
				"wallTimeMs": { "$ref": "#/$defs/nonNegative" },
				"throughputFps": { "$ref": "#/$defs/nonNegative" },
				"outputBytes": { "$ref": "#/$defs/nonNegativeInteger" },
				"outputSha256": { "$ref": "#/$defs/sha256" },
				"hardwareEncoder": { "type": "boolean" },
				"avDriftMs": { "type": "number" },
				"durationErrorMs": { "type": "number" },
				"peakRssBytes": { "$ref": "#/$defs/nonNegativeInteger" }
			}
		},
		"audio": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"samples",
				"sampleRate",
				"lagSamples",
				"inputLufs",
				"outputLufs",
				"inputTruePeakDbtp",
				"outputTruePeakDbtp",
				"correlation"
			],
			"properties": {
				"kind": { "const": "audio" },
				"samples": { "$ref": "#/$defs/nonNegativeInteger" },
				"sampleRate": { "type": "integer", "minimum": 8000, "maximum": 384000 },
				"lagSamples": { "type": "integer" },
				"inputLufs": { "type": "number" },
				"outputLufs": { "type": "number" },
				"inputTruePeakDbtp": { "type": "number" },
				"outputTruePeakDbtp": { "type": "number" },
				"decodedAacTruePeakDbtp": { "type": "number" },
				"correlation": { "type": "number", "minimum": -1, "maximum": 1 }
			}
		},
		"asr": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"referenceWords",
				"wordErrors",
				"wer",
				"cer",
				"protectedTermErrors",
				"boundaryP50Ms",
				"boundaryP95Ms",
				"realTimeFactor"
			],
			"properties": {
				"kind": { "const": "asr" },
				"referenceWords": { "$ref": "#/$defs/nonNegativeInteger" },
				"wordErrors": { "$ref": "#/$defs/nonNegativeInteger" },
				"wer": { "$ref": "#/$defs/rate" },
				"cer": { "$ref": "#/$defs/rate" },
				"protectedTermErrors": { "$ref": "#/$defs/nonNegativeInteger" },
				"boundaryP50Ms": { "$ref": "#/$defs/nonNegative" },
				"boundaryP95Ms": { "$ref": "#/$defs/nonNegative" },
				"realTimeFactor": { "$ref": "#/$defs/nonNegative" }
			}
		},
		"automaticDirection": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"expectedEvents",
				"generatedEvents",
				"unchangedRate",
				"correctionSeconds",
				"deleteRate",
				"cursorContainmentRate",
				"privacyViolations",
				"previewExportMismatches"
			],
			"properties": {
				"kind": { "const": "automatic-direction" },
				"expectedEvents": { "$ref": "#/$defs/nonNegativeInteger" },
				"generatedEvents": { "$ref": "#/$defs/nonNegativeInteger" },
				"unchangedRate": { "$ref": "#/$defs/rate" },
				"correctionSeconds": { "$ref": "#/$defs/nonNegative" },
				"deleteRate": { "$ref": "#/$defs/rate" },
				"cursorContainmentRate": { "$ref": "#/$defs/rate" },
				"privacyViolations": { "$ref": "#/$defs/nonNegativeInteger" },
				"previewExportMismatches": { "$ref": "#/$defs/nonNegativeInteger" }
			}
		},
		"uiPerformance": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"durationMs",
				"frames",
				"inputLatencyP50Ms",
				"inputLatencyP95Ms",
				"inputLatencyP99Ms",
				"longTasks",
				"droppedFrames",
				"peakRssBytes"
			],
			"properties": {
				"kind": { "const": "ui-performance" },
				"durationMs": { "$ref": "#/$defs/nonNegative" },
				"frames": { "$ref": "#/$defs/nonNegativeInteger" },
				"inputLatencyP50Ms": { "$ref": "#/$defs/nonNegative" },
				"inputLatencyP95Ms": { "$ref": "#/$defs/nonNegative" },
				"inputLatencyP99Ms": { "$ref": "#/$defs/nonNegative" },
				"longTasks": { "$ref": "#/$defs/nonNegativeInteger" },
				"droppedFrames": { "$ref": "#/$defs/nonNegativeInteger" },
				"peakRssBytes": { "$ref": "#/$defs/nonNegativeInteger" }
			}
		},
		"nonNegative": { "type": "number", "minimum": 0 },
		"nonNegativeInteger": { "type": "integer", "minimum": 0 },
		"rate": { "type": "number", "minimum": 0, "maximum": 1 }
	}
}
