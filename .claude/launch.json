{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "env": {
        "NO_ELECTRON": "1"
      }
    },
    {
      "name": "desktop-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5201",
        "--strictPort"
      ],
      "port": 5201,
      "env": {
        "NO_ELECTRON": "1"
      }
    },
    {
      "name": "v4preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.v4preview.config.ts"
      ],
      "port": 5207
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "serve",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111
    },
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev",
        "--",
        "--port",
        "3112"
      ],
      "port": 3112
    },
    {
      "name": "ui-concepts",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5233",
        "--directory",
        "design/concepts/2026-10-04-ui"
      ],
      "port": 5233
    }
  ]
}