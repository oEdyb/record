{
	"name": "klippt",
	"private": true,
	"version": "1.9.5",
	"description": "A clip-native screen recorder and editor for creators.",
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "npm@10.9.4",
	"engines": {
		"node": "22.22.1",
		"npm": "10.9.4"
	},
	"author": {
		"name": "Dyberg & Co AB"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oEdyb/record.git"
	},
	"contributors": [
		{
			"name": "Siddharth Vaddem",
			"url": "https://github.com/siddharthvaddem"
		},
		{
			"name": "Etienne Lescot",
			"url": "https://github.com/EtienneLescot"
		}
	],
	"maintainers": [
		{
			"name": "Olle Dyberg"
		}
	],
	"scripts": {
		"dev": "vite",
		"build": "npm run clean:compiled && tsc && vite build && electron-builder",
		"clean:compiled": "node scripts/clean-compiled-output.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"i18n:check": "node scripts/i18n-check.mjs",
		"docs:check": "node scripts/check-docs.mjs && node scripts/sync-design-tokens.mjs --check",
		"design:check": "node scripts/check-design-policy.mjs",
		"design:sync": "node scripts/sync-design-tokens.mjs",
		"corpus:validate": "node scripts/creator-corpus.mjs validate",
		"test:corpus": "vitest --run scripts/creator-corpus.test.mjs",
		"supply-chain:inventory": "node scripts/generate-release-inventory.mjs --output-dir release/supply-chain",
		"supply-chain:audit-website": "node scripts/check-website-audit.mjs",
		"supply-chain:cargo-licenses": "node scripts/generate-cargo-license-inventory.mjs",
		"supply-chain:notices": "node scripts/generate-third-party-inventory.mjs",
		"supply-chain:web-demuxer": "node scripts/web-demuxer-source.mjs",
		"test:supply-chain": "vitest --run scripts/check-approved-dependencies.test.mjs scripts/check-cargo-graphs.test.mjs scripts/check-website-audit.test.mjs scripts/check-workflow-action-pins.test.mjs scripts/check-release-workflow-contract.test.mjs scripts/check-update-release-order.test.mjs scripts/generate-cargo-license-inventory.test.mjs scripts/generate-release-inventory.test.mjs scripts/generate-third-party-inventory.test.mjs scripts/helper-provenance.test.mjs scripts/native-ffmpeg-source.test.mjs scripts/stage-whisper-stt.test.mjs scripts/stage-update-release.test.mjs scripts/update-feed-integrity.test.mjs scripts/verify-packaged-distribution.test.mjs scripts/verify-published-release.test.mjs scripts/web-demuxer-source.test.mjs scripts/fetch-ffmpeg.test.mjs scripts/prepare-semgrep-cpp-rules.test.mjs scripts/resolve-release-source.test.mjs",
		"assets:brand": "node scripts/generate-brand-assets.mjs",
		"assets:appx": "node scripts/generate-appx-assets.mjs",
		"preview": "vite preview",
		"build:native:mac": "node scripts/build-macos-screencapturekit-helper.mjs",
		"build:native:parakeet:mac": "node scripts/build-parakeet-stt-helper.mjs",
		"build:native:clean-voice:mac": "node scripts/build-clean-voice-helper.mjs",
		"build:mac": "npm run build:native:mac && npm run build:native:parakeet:mac && npm run fetch:ffmpeg:mac && npm run build:native:compositor:mac && npm run build-vite && electron-builder --mac",
		"release:check:mac": "node scripts/check-macos-release-readiness.mjs",
		"build:native:win": "node scripts/build-windows-wgc-helper.mjs",
		"stage:vcomp": "node scripts/stage-vcomp-runtime.mjs",
		"build:native:compositor": "node scripts/build-windows-compositor-addon.mjs",
		"build:native:compositor:mac": "node scripts/build-macos-compositor-addon.mjs",
		"build:native:compositor:linux": "node scripts/build-linux-compositor-addon.mjs",
		"build:native:linux": "node scripts/build-linux-pipewire-helper.mjs",
		"build:win": "npm run build:native:win && npm run fetch:ffmpeg && npm run stage:vcomp && npm run build:native:compositor && npm run build-vite && electron-builder --win --config.npmRebuild=false",
		"build:win:store": "npm run build:native:win && npm run fetch:ffmpeg && npm run stage:vcomp && npm run build:native:compositor && npm run build-vite && electron-builder --win appx --config.npmRebuild=false",
		"build:linux": "npm run fetch:ffmpeg:sdk && npm run build:native:linux && npm run build:native:compositor:linux && npm run build-vite && electron-builder --linux AppImage deb pacman rpm --config.npmRebuild=false",
		"build:whisper-binaries": "bash scripts/build-whisper-stt.sh",
		"clean-voice:lab": "npm run build:native:clean-voice:mac && node scripts/clean-voice-lab.mjs",
		"test:whisper-stt": "node scripts/test-whisper-stt.mjs",
		"test:clean-voice": "npm run build:native:clean-voice:mac && node scripts/test-clean-voice-helper.mjs --long",
		"test": "vitest --run",
		"test:changed": "vitest --run --changed",
		"test:watch": "vitest",
		"test:cursor-native:win": "node scripts/test-windows-native-cursor.mjs",
		"test:wgc-helper:win": "node scripts/test-windows-wgc-helper.mjs",
		"test:wgc-window:win": "node scripts/test-windows-wgc-helper.mjs --window",
		"test:wgc-audio:win": "node scripts/test-windows-wgc-helper.mjs --system-audio",
		"test:wgc-mic:win": "node scripts/test-windows-wgc-helper.mjs --microphone",
		"test:wgc-mixed-audio:win": "node scripts/test-windows-wgc-helper.mjs --system-audio --microphone",
		"test:wgc-webcam:win": "node scripts/test-windows-wgc-helper.mjs --webcam",
		"test:wgc-full:win": "node scripts/test-windows-wgc-helper.mjs --webcam --system-audio --microphone",
		"capture:openscreen-preview": "node scripts/capture-openscreen-preview.mjs",
		"inspect:cursor-click-bounce": "node scripts/inspect-native-cursor-click-bounce.mjs",
		"diagnostic:run": "node scripts/diagnostic-tool/diagnostic.mjs",
		"diagnostic:smoke:win": "node scripts/diagnostic-tool/diagnostic.mjs --duration 3",
		"gate2:soak:mac": "node scripts/gate2-macos-soak.mjs",
		"build-vite": "npm run clean:compiled && tsc && vite build",
		"cli": "electron .",
		"test:e2e": "playwright test",
		"test:e2e:windows-native-checklist": "playwright test tests/e2e/windows-native-checklist.spec.ts",
		"prepare": "husky",
		"fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
		"fetch:ffmpeg:mac": "node scripts/fetch-ffmpeg-macos.mjs",
		"fetch:ffmpeg:sdk": "node scripts/fetch-ffmpeg.mjs --sdk-only"
	},
	"dependencies": {
		"@fix-webm-duration/fix": "^1.0.1",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tiptap/react": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron-updater": "^6.8.9",
		"i18next": "^23.16.0",
		"lucide-react": "^0.545.0",
		"mediabunny": "^1.40.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"web-demuxer": "^4.0.0",
		"zod": "^4.1.12",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@biomejs/biome": "^2.4.12",
		"@cyclonedx/cyclonedx-library": "10.2.0",
		"@electron/fuses": "2.1.3",
		"@playwright/test": "^1.59.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.19.17",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.2.0",
		"ajv": "8.20.0",
		"autoprefixer": "^10.5.0",
		"electron": "44.9.1",
		"electron-builder": "^26.15.3",
		"husky": "^9.1.7",
		"jsdom": "^29.0.2",
		"lint-staged": "^16.4.0",
		"postcss": "^8.5.25",
		"tailwindcss": "^3.4.19",
		"terser": "^5.46.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vitest": "^4.1.10"
	},
	"main": "dist-electron/bootstrap.js",
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mts,cts,json}": "biome check --no-errors-on-unmatched"
	}
}
