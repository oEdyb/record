	"applicationBuild": {
		"requiredEntrypoints": [
			"dist/index.html",
			"dist-electron/bootstrap.js",
			"dist-electron/preload.mjs"
		],
		"compiledOutputPatterns": [
			"^dist/index\\.html$",
			"^dist/assets/[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9_-]{8}\\.(?:js|css|json)$",
			"^dist-electron/(?:bootstrap\\.js|preload\\.mjs|[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9_-]{8}\\.js)$"
		],
		"excludedOutputs": [
			{
				"pattern": "^dist/\\.vite/manifest\\.json$",
				"builderPattern": "!dist/.vite/manifest.json"
			},
			{
				"pattern": "^dist/wasm/web-demuxer\\.wasm$",
				"builderPattern": "!dist/wasm/web-demuxer.wasm"
			},
			{
				"pattern": "^dist/cursors(?:/.*)?$",
				"builderPattern": "!dist/cursors{,/**/*}"
			},
			{
				"pattern": "^dist/wallpapers(?:/.*)?$",
				"builderPattern": "!dist/wallpapers{,/**/*}"
			},
			{
				"pattern": "^dist/demo\\.gif$",
				"builderPattern": "!dist/demo.gif"
			},
			{
				"pattern": "^dist/openscreen\\.png$",
				"builderPattern": "!dist/openscreen.png"
			},
			{
				"pattern": "^dist/preview[^/]*\\.png$",
				"builderPattern": "!dist/preview*.png"
			},
			{
				"pattern": "^dist/vite\\.svg$",
				"builderPattern": "!dist/vite.svg"
			}
		]
	},
	"excluded": [
		{
			"id": "legacy-sweezy-cursor-packs",
			"paths": [
				"public/cursors/among-us-sus-knife-and-red-animated/**",
				"public/cursors/black-and-rainbow-stroke-gradient-animated/**",
				"public/cursors/black-pixel/**",
